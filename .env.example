# ──────────────────────────────────────────────────────────────────────────────
# Raj Tandoor — environment variables
# Copy this file to .env and fill in the values before deploying.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# Contact form endpoint
# POST requests from the enquiry form will be sent here as JSON.
# Provide a server-side handler (e.g. a serverless function or email service).
# Leave empty in development — the form will show a "not connected" notice.
# Example: https://api.rajtandoor.com/enquiry
VITE_CONTACT_ENDPOINT=

# Public site URL (used for canonical tags and sitemap)
VITE_SITE_URL=https://rajtandoor.com
