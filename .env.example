# ── Supabase ──────────────────────────────────────────────────────────────────
# Find these in your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── Setup notes ───────────────────────────────────────────────────────────────
# 1. Copy this file to .env.local and fill in your values.
#    .env.local is gitignored and never committed.
#
# 2. On Vercel: add both variables under Project → Settings → Environment Variables
#    for Production, Preview, and Development environments.
#
# 3. In Supabase: add your production URL to the allowed Redirect URLs list
#    under Authentication → URL Configuration so email confirmation and
#    password reset links work in production.
#    Example: https://your-domain.vercel.app/**
