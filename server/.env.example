# API server port
PORT=3001

# JWT secret — change this before deploying to production
JWT_SECRET=change-this-to-a-long-random-secret-before-production

# Database directory (defaults to <project-root>/data)
# DB_DIR=/absolute/path/to/data

# Optional: email integration (not required for dev)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# NOTIFY_EMAIL=

# NODE_ENV: 'development' or 'production'
NODE_ENV=development
